{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".features-gen"
  ]
}
