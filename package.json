  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:bdd": "npx bddgen && npx playwright test --project=bdd",
    "test:bdd:tags": "npx bddgen && npx playwright test --project=bdd --grep",
    "bddgen": "npx bddgen",
    "report:allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "report:monocart": "start monocart-report/index.html"
  },
